# A.R.I.A - Asistente personal de IA
# Copia este archivo a `.env` y ajusta los valores.
# NUNCA guardes aquí secretos reales y nunca subas tu `.env` a git.

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Servidor
HOST=0.0.0.0
PORT=8000

# Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Identidad de la aplicación
APP_NAME=A.R.I.A
APP_VERSION=0.1.0

# Directorio de datos locales (SQLite, archivos generados)
DATA_DIR=data

# LLM (FASE 2)
# Proveedor: openai_compatible (OpenAI, Groq, OpenRouter, Ollama, LM Studio...)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
# Prompt de sistema personalizado (vacío = prompt por defecto de SIA)
LLM_SYSTEM_PROMPT=
LLM_MAX_TOKENS=256

# LLM respaldo (failover): si el principal falla, SIA usa este automáticamente
# Groq (gratis): crea tu key en https://console.groq.com/keys
LLM_FALLBACK_PROVIDER=openai_compatible
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Herramientas (FASE 3)
# Lista separada por comas de herramientas habilitadas (vacío = todas).
# Integradas: get_time, get_system_info, open_website
TOOLS_ENABLED=
# Herramientas que no piden confirmación aunque lo requieran (comas)
TOOLS_AUTO_CONFIRM=

# Memoria (FASE 4)
# SQLite persistente en DATA_DIR/sia.db (sesiones, mensajes y hechos)
MEMORY_ENABLED=true

# Identidad y autoaprendizaje
# A.R.I.A sabe quién la creó y lo trata como su jefe.
# (También se acepta el nombre histórico SIA_CREATOR_NAME.)
ARIA_CREATOR_NAME=Samuel
# Tras cada conversación, SIA extrae sola los datos importantes de ti y los
# memoriza (gustos, personas, proyectos...). Desactívalo con false.
AUTO_LEARN_ENABLED=true
# Curiosidad autónoma: tras charlas interesantes, SIA investiga el tema en
# internet (DuckDuckGo), sintetiza lo esencial y lo guarda para siempre.
AUTO_CURIOSITY_ENABLED=true

# Voz (FASES 5-7)
STT_LANGUAGE=es-ES
# Motor de transcripción: google (gratis, ~1-2 s) | groq (whisper-turbo, ~0.3 s)
# STT_GROQ_API_KEY vacío reutiliza LLM_FALLBACK_API_KEY si el respaldo es Groq.
STT_PROVIDER=google
STT_GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_GROQ_MODEL=whisper-large-v3-turbo
STT_GROQ_API_KEY=
# Motor de síntesis: auto (= edge, voz neuronal natural) | gtts | edge | piper
TTS_PROVIDER=auto
PIPER_MODEL=data/piper/es_MX-ald-medium.onnx
# Voces naturales: es-MX-DaliaNeural (mujer), es-MX-JorgeNeural (hombre),
# es-ES-ElviraNeural / es-ES-AlvaroNeural (España)…
TTS_VOICE=es-MX-DaliaNeural
# Tono natural: evita pitches altos (+12Hz suena robótico).
TTS_RATE=+3%
TTS_PITCH=+0Hz
# Palabra de activación (vacío = responder siempre que se escuche algo)
WAKE_WORD=aria

# Token de acceso para usar SIA desde el celular u otro equipo (vacío = sin
# candado). Genera uno con: openssl rand -hex 16
# La propia PC (localhost) NUNCA pide el token; solo clientes remotos.
# Si lo defines, la app del celular lo pedirá la primera vez.
ACCESS_TOKEN=

# Charla espontánea (habla sin que le preguntes)
PROACTIVE_ENABLED=true
PROACTIVE_MIN_MINUTES=8
PROACTIVE_MAX_MINUTES=25
PROACTIVE_MAX_PER_HOUR=3
PROACTIVE_QUIET_START=23
PROACTIVE_QUIET_END=8
